{
	"name": "groceries",
	"version": "0.6.0",
	"private": true,
	"description": "Shared shopping lists for Nextcloud, as an installable mobile app",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kammarc/nextcloud-groceries.git"
	},
	"bugs": {
		"url": "https://github.com/kammarc/nextcloud-groceries/issues"
	},
	"homepage": "https://github.com/kammarc/nextcloud-groceries",
	"type": "module",
	"scripts": {
		"build": "node scripts/build-catalog.mjs && node scripts/build-emoji.mjs && vite build && vite build --config vite.settings.config.ts",
		"dev": "node scripts/build-emoji.mjs && vite build --watch --mode development",
		"catalog": "node scripts/build-catalog.mjs",
		"emoji": "node scripts/build-emoji.mjs",
		"icons": "node scripts/build-icons.mjs",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ionic/vue": "^8.4.1",
		"@ionic/vue-router": "^8.4.1",
		"idb-keyval": "^6.2.1",
		"ionicons": "^7.4.0",
		"pinia": "^2.3.0",
		"uqr": "^0.1.3",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@vitejs/plugin-vue": "^5.2.1",
		"cldr-annotations-derived-full": "^48.2.0",
		"cldr-annotations-full": "^48.2.0",
		"typescript": "~5.7.2",
		"unicode-emoji-json": "^0.8.0",
		"vite": "^6.0.7",
		"vitest": "^4.0.0",
		"vue-tsc": "^3.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
