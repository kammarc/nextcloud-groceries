{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"strict": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "tests/js/**/*.ts"]
}
